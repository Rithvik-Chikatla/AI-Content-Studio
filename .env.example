# Get your free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (SQLite via Prisma)
DATABASE_URL="file:./dev.db"

# Auth secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=your_auth_secret_here
AUTH_URL=http://localhost:3000

# Google OAuth (optional) — https://console.cloud.google.com/
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (optional) — https://portal.azure.com/
# Redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

